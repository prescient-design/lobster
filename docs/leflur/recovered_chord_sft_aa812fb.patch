@@ -186,3 +186,107 @@ def _validate_with_esmfold(
 
     # Return the metrics for aggregate statistics
     return folded_structure_metrics
+
+
+def _split_backbone_by_chain(coords_res, real_chains) -> list[tuple[list[int], str]]:
+    """Split a loaded PDB's per-residue chain ids into contiguous chain blocks.
+
+    ``real_chains`` is the ``(N,)`` int32 tensor of ``ord(chain_letter)`` values that
+    :func:`~lobster.model.latent_generator.io.load_pdb` returns (one per residue, in file
+    order). Returns a list of ``(residue_indices, chain_letter)`` for each maximal run of
+    equal chain id, preserving order — the packer packs all chains together (so inter-chain
+    context informs the χ torsions) but must know the split points and original letters.
+    """
+    ords = [int(c) for c in real_chains.tolist()]
+    blocks: list[tuple[list[int], str]] = []
+    start = 0
+    for i in range(1, len(ords) + 1):
+        if i == len(ords) or ords[i] != ords[start]:
+            blocks.append((list(range(start, i)), chr(ords[start])))
+            start = i
+    return blocks
+
+
+def _pack_generated_structures(cfg, device: torch.device, output_dir: Path) -> None:
+    """Optional post-generation pass: repack side chains onto the backbone PDBs.
+
+    LeFlur emits **backbone-only** structures (``writepdb`` synthesizes only an idealized
+    O + Cβ). When ``generation.pack_side_chains`` is set, this pass re-reads each backbone
+    PDB just written under ``output_dir``, rebuilds every side chain in process with the
+    LigandMPNN packer (:func:`~lobster.model.latent_generator.io.pack_structure`), and
+    writes an all-atom ``<name>_packed.pdb`` next to it. Multi-chain PDBs (e.g. binder
+    complexes) are packed as one complex so inter-chain context informs the χ torsions;
+    the original chain letters and per-chain residue order are preserved.
+
+    The packer is CPU-viable (~0.66 s/design @ 8 threads, all valid) and defaults to CPU
+    (``generation.packing.device``); scale by fanning out CPU workers rather than
+    contending for the GPU queue (memory ``ligandmpnn-packer-cpu-viable``).
+
+    Parameters
+    ----------
+    cfg : DictConfig
+        The generation config. Reads the ``generation.packing`` block:
+        ``device`` (default ``"cpu"``), ``num_denoising_steps`` (3), ``num_samples`` (4),
+        ``glob`` (default ``"*.pdb"``), ``ligandmpnn_path`` / ``sc_ckpt`` (optional env
+        overrides for the LigandMPNN install + checkpoint).
+    device : torch.device
+        The generation device; used only as the fallback when ``packing.device`` is unset.
+    output_dir : Path
+        Directory holding the backbone PDBs to repack (and where ``*_packed.pdb`` land).
+    """
+    import os
+
+    packing = cfg.generation.get("packing", {}) or {}
+    pack_device = packing.get("device", None) or "cpu"
+    num_denoising_steps = int(packing.get("num_denoising_steps", 3))
+    num_samples = int(packing.get("num_samples", 4))
+    pattern = packing.get("glob", "*.pdb")
+
+    # Optional env overrides for the LigandMPNN install / packer checkpoint. Setting them
+    # before the first packer build lets a run point at a non-default LigandMPNN without
+    # touching the environment (the engine reads these at module import + Repacker init).
+    if packing.get("ligandmpnn_path", None):
+        os.environ["LIGANDMPNN_PATH"] = str(packing["ligandmpnn_path"])
+    if packing.get("sc_ckpt", None):
+        os.environ["LIGANDMPNN_SC_CKPT"] = str(packing["sc_ckpt"])
+
+    # Derived artifacts are never the primary design: skip already-packed outputs
+    # (idempotency) and ESMFold refolds (validation predictions, not the generated model).
+    def _is_derived(name: str) -> bool:
+        return "_packed" in name or "_esmfold" in name
+
+    pdbs = sorted(p for p in output_dir.glob(pattern) if not _is_derived(p.name))
+    if not pdbs:
+        logger.warning(f"pack_side_chains: no backbone PDBs matched {pattern!r} under {output_dir}")
+        return
+
+    logger.info(
+        f"pack_side_chains: repacking {len(pdbs)} structure(s) on {pack_device} "
+        f"(steps={num_denoising_steps}, samples={num_samples})"
+    )
+    n_ok = 0
+    for pdb in pdbs:
+        out_path = pdb.with_name(f"{pdb.stem}_packed.pdb")
+        try:
+            loaded = load_pdb(str(pdb), add_batch_dim=False)
+            if loaded is None:
+                logger.warning(f"pack_side_chains: could not load {pdb.name}, skipping")
+                continue
+            coords_res = loaded["coords_res"].numpy()  # (N, 3, 3) [N, CA, C]
+            seq_str = loaded["sequence_str"]
+            blocks = _split_backbone_by_chain(coords_res, loaded["real_chains"])
+            chains = [(coords_res[idx], "".join(seq_str[j] for j in idx)) for idx, _ in blocks]
+            chain_letters = [letter for _, letter in blocks]
+
+            X14, X_m, S, chain_sizes = pack_structure(
+                chains,
+                device=pack_device,
+                num_denoising_steps=num_denoising_steps,
+                num_samples=num_samples,
+            )
+            write_packed_pdb(str(out_path), X14, X_m, S, chain_sizes, chain_letters)
+            n_ok += 1
+            logger.info(f"pack_side_chains: wrote {out_path.name}")
+        except Exception as exc:  # noqa: BLE001 — one bad structure must not fail the run
+            logger.warning(f"pack_side_chains: failed on {pdb.name}: {exc}")
+    logger.info(f"pack_side_chains: packed {n_ok}/{len(pdbs)} structures")
