+    lp_a = pa.logprob_over_trajectory(ta)
+    sft_a = pa.sequence_sft_loss(ta, target, sup, label="hard", use_phi=True)
+    ((1.0 - mu) * (-lp_a.mean()) + mu * sft_a).backward()
+
+    # Fused path: one forward feeding both.
+    lp_b, sft_b = pb.logprob_and_sft_over_trajectory(tb, target, sup, label="hard", use_phi=True)
+    ((1.0 - mu) * (-lp_b.mean()) + mu * sft_b).backward()
+
+    for name in ("w_seq", "w_struc", "w_tri", "c_seq", "c_struc", "c_tri"):
+        ga, gb = getattr(pa, name).grad, getattr(pb, name).grad
+        assert ga is not None and gb is not None and torch.isfinite(gb).all()
+        torch.testing.assert_close(ga, gb, atol=1e-5, rtol=1e-5)
