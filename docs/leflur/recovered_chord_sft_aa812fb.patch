+def test_fused_gradient_parity_matches_separate() -> None:
+    """Backward through the fused blend gives identical parameter grads to the separate path."""
+    mu = 0.1
+    pa, pb = _FakePolicy(seed=0), _FakePolicy(seed=0)
+    pb.load_state_dict(pa.state_dict())
+    ta, tb = _make_trajectory(), _make_trajectory()
