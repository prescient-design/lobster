+# --- logprob_and_sft_over_trajectory (lever B: fuse logprob + SFT forwards) -----
+#
+# The CHORD PPO inner loop runs `logprob_over_trajectory` (GRPO log-prob) and
+# `sequence_sft_loss` (distillation CE) over the SAME step subset, each doing its own
+# encoder forward. `logprob_and_sft_over_trajectory` fuses them into ONE forward per step,
+# feeding the biased per-track logits to the log-prob and the RAW conditional seq logits
+# (captured pre-CFG/pre-bias) to the SFT CE. The forward is deterministic (eval-mode / fake
+# forward here), so the fused pair must be bit-identical to the two separate calls — that
+# byte-identity is the whole point of the lever, so these tests pin it hard.
+
+
+def _sft_payload(batch_size: int = 2, length: int = 4, vocab: int = SEQ_VOCAB, seed: int = 3):
+    """Build (target_ids_33, supervise_mask, soft_targets) for the SFT term."""
+    g = torch.Generator().manual_seed(seed)
+    target = torch.randint(0, 20, (batch_size, length), generator=g, dtype=torch.long)  # canonical AAs < V
+    sup = torch.zeros(batch_size, length, dtype=torch.bool)
+    sup[:, 1:] = True  # supervise everything the mask lets through (pos 0 is fixed)
+    soft = torch.rand(batch_size, length, vocab, generator=g)
+    soft = soft / soft.sum(dim=-1, keepdim=True)  # a proper distribution over the 33-token space
+    return target, sup, soft
+
+
